# Copy to .env.local and fill from the Supabase and EmailJS dashboards.
# .env.local is gitignored (`*.local`); never commit real values.

# Client: Vite only exposes VITE_* to the browser, so these are public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only: Vercel environment variables and .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner allowlist and pinned TOTP factor (server only; never VITE_*).
# Get both from `node --env-file=.env.local scripts/auth-info.mjs`.
# Unset means the admin API rejects every request.
ADMIN_USER_ID=
ADMIN_TOTP_FACTOR_ID=

# Server-side sending needs "API access from non-browser environments"
# enabled in EmailJS → Account → Security; without it every send returns 403.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Salt for the contact form's per-IP hash (any long random string; server
# only). Unset makes POST /api/inquiries fail closed with 500.
INQUIRY_IP_SALT=

# Protects GET /api/keepalive and GET /api/backup (any long random string).
# Vercel cron requests carry it automatically; a manual run needs
# `Authorization: Bearer <CRON_SECRET>`. Unset = both endpoints return 401.
# The weekly backup goes to the private Supabase Storage bucket `backups`,
# which api/backup.mjs creates on first run.
CRON_SECRET=
